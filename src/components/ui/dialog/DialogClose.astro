---
/**
 * DialogClose — button that closes a <dialog>.
 *
 * Pass `commandfor` with the dialog's id to close it declaratively, with no
 * JavaScript: the browser handles the click, focus return and `aria-expanded`.
 * Without it (or on browsers without Invoker Commands) the client fallback
 * closes the nearest ancestor <dialog>.
 * Consumer provides the visual (icon, text, kbd hint) via default slot.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  /** The id of the <dialog> to close. */
  commandfor?: string;
}

// A composing component can pass its own `data-slot` in place of this one.
const { class: className, commandfor: commandFor, "data-slot": slot = "dialog-close", ...attrs } = Astro.props;
---

<button
  data-slot={slot}
  data-dialog-close
  type="button"
  class={cn(className)}
  {...(commandFor ? ({ command: "close", commandfor: commandFor } as Record<string, string>) : {})}
  {...attrs}
>
  <slot />
</button>

<script>
  import "./dialog-close.client";
</script>
