---
/* The site's logo, inline so it takes the text colour in light and dark. The
   drawing lives in logo.ts, which the social cards read too. */
import { logo } from "./logo";

interface Props { class?: string }
// Callers size it by height; the wordmark keeps its own width.
const { class: cls = "h-4 w-auto" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={logo.viewBox} class={cls} aria-hidden="true">{logo.paths.map((d) => <path d={d} fill="currentColor" />)}</svg>
